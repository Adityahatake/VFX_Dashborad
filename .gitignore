# Allowlist style: ignore everything, then re-include only source we want in git.
*
!.gitignore
!.env.example
!README.md
!CLAUDE.md
!requirements.txt
!pyproject.toml
!*/
!app/**/*.py
!core/**/*.py
!api/**/*.py
!web/package.json
!web/package-lock.json
!web/index.html
!web/vite.config.ts
!web/tsconfig.json
!web/src/**/*.ts
!web/src/**/*.tsx
!web/src/**/*.css
!scripts/**/*.py
!tests/**/*.py
!pipelines/*/pipeline.yaml
!pipelines/*/sop/**/*.md
!pipelines/*/steps/*.py
# Never, even if matched above
node_modules/
web/dist/
.env
.venv/
data/
*.sqlite*
__pycache__/
*.pyc
*.csv
service-account*.json
