# Google Sheets (service account with edit access to the target sheet)
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Development and tests write ONLY here, never to the real sheet
SANDBOX_SHEET_ID=
# Reserved for the 'Sync to keys sheet' button (not built yet)
KEYS_SHEET_ID=

# Apify: comma-separated pool (the dashboard picks one key per job by live balance)
APIFY_TOKEN_POOL=
# Tavily: comma-separated
TAVILY_API_KEYS=

# Optional LLM assist (off unless enabled in Settings and set here)
ANTHROPIC_API_KEY=

# Where .env backups go before the app edits it (must be outside the repo)
LPD_ENV_BACKUP_DIR=
